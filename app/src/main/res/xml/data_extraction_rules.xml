<?xml version="1.0" encoding="utf-8"?>
<!-- G9 keeps nothing of its own but a few settings, which travel through Settings -> Backup like
     every Nine app's; the photos themselves are the phone's, not G9's. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
